# ──────────────────────────────────────────────
# CCMS Backend Environment Configuration
# Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
ALLOW_ALL_ORIGINS=false

# ── Database (MySQL) ──────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ccms_db
DB_SSL=false
DB_POOL_SIZE=10

# ── Authentication ────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Tools ─────────────────────────────────────
MYSQL_BIN=mysql
